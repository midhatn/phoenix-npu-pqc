_scratch_*/

# Local backup files created during in-place kernel patching
*.pre-v3b-patch.bak

# NIST ACVP-Server KAT vectors for Post-Quantum Cryptography reference tests.
# The global *.json rule above must NOT hide these -- they are required by the
# M32e ML-KEM composer test and the M33d/M33e ML-DSA composer tests to
# reproduce 33/33 silicon PASS. See docs/PQC_COMPLETE_V1.md.
!tests/m32_mlkem/vectors/*.json
!tests/m33_mldsa/vectors/*.json
!tests/pqc_device_resident/data/*.json
# The protected DR2 forensic capture includes one required raw byte stream.
!docs/pqc_dr2_evidence_20260818/PQC_DR2D_W0_token_tap_tcId01_raw_20260818.bin

# Confidential & Private Business / Investor Pitches
private_pitch/
confidential/
*PITCH*
*ONE_PAGER*

aianalyzer.log
