r"""Windows clean-clone launcher for the Phoenix NPU PQC native installer.

Run this from a fresh clone:

    git clone https://github.com/midhatn/phoenix-npu-pqc.git
    cd phoenix-npu-pqc
    py .\install

This launcher is deliberately thin: the maintained implementation lives in
``install.py`` (stdlib-only, so it runs on a stock CPython 3.13 x64 before
ironenv exists). ``py .\install.py`` remains supported as the legacy entry
point.

Behaviour contract:

* A normal full install provisions the native toolchain (pinned XRT Windows
  SDK, pinned mlir-aie commit, pinned ``mlir_aie`` cp313 wheel, official
  ``iron_setup``, vendored ``pyxrt``, Peano/llvm-aie) and then automatically
  hands off to the canonical physical runner ``run_all_silicon_tests.py`` under
  the checkout ironenv. That is done by appending ``--run-tests``.
* Maintenance modes (``--check-only``, ``--download-only``, ``--self-test``)
  and the explicit ``--no-tests`` opt-out never compile an AIE program and
  never dispatch hardware, so the handoff is not added for them.
* ``--no-tests`` and ``--run-tests`` are mutually exclusive. Combining them is
  an argument error; the launcher never guesses which physical-dispatch intent
  the operator meant.

Integrity boundary: the directly downloaded XRT SDK zip and ``mlir_aie`` wheel
are verified by exact byte length and SHA-256 from ``toolchain.yaml``, and
mlir-aie is pinned to an exact commit. The official ``iron_setup`` step then
resolves a transitive Python dependency set from package indexes that this
repository does NOT fully hash-lock.
"""

from __future__ import annotations

import runpy
import sys
from collections.abc import Sequence
from pathlib import Path

CANONICAL_PHYSICAL_RUNNER = "run_all_silicon_tests.py"
INSTALL_IMPLEMENTATION = "install.py"
HANDOFF_OPTION = "--run-tests"
NO_TESTS_OPTION = "--no-tests"
MAINTENANCE_OPTIONS = frozenset(
    {
        "--check-only",
        "--download-only",
        "--self-test",
    }
)


def build_install_argv(argv: Sequence[str]) -> list[str]:
    """Forward arguments, adding the canonical runner handoff for a full install.

    A default ``py .\\install`` therefore ends in a physical Phoenix NPU
    dispatch of ``run_all_silicon_tests.py``.
    """

    opted_out = NO_TESTS_OPTION in argv
    explicit_handoff = HANDOFF_OPTION in argv
    if opted_out and explicit_handoff:
        raise ValueError(
            f"{NO_TESTS_OPTION} and {HANDOFF_OPTION} are mutually exclusive"
        )
    forwarded = [arg for arg in argv if arg != NO_TESTS_OPTION]
    is_maintenance_mode = any(arg in MAINTENANCE_OPTIONS for arg in forwarded)
    if HANDOFF_OPTION not in forwarded and not is_maintenance_mode and not opted_out:
        forwarded.append(HANDOFF_OPTION)
    return forwarded


def main(argv: Sequence[str] | None = None) -> int:
    """Run the maintained native installer as its command-line entry point."""

    target = Path(__file__).with_name(INSTALL_IMPLEMENTATION)
    if not target.is_file():
        print(f"ERROR: missing installer implementation: {target}", file=sys.stderr)
        return 2
    try:
        forwarded = build_install_argv(sys.argv[1:] if argv is None else argv)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    original_argv = sys.argv
    try:
        sys.argv = [str(Path(__file__)), *forwarded]
        runpy.run_path(
            str(target),
            run_name="__main__",
            init_globals={"PHOENIX_INSTALL_LAUNCHER": True},
        )
    finally:
        sys.argv = original_argv
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
