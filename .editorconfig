# EditorConfig — https://editorconfig.org
# Consistent whitespace / EOL across editors and OSes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows-native shell scripts keep CRLF
[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf

# Markdown allows trailing spaces (used for line breaks in some flavors)
[*.md]
trim_trailing_whitespace = false

# YAML / JSON conventionally use 2-space indent
[*.{yml,yaml,json}]
indent_size = 2

# Makefiles require literal tabs
[Makefile]
indent_style = tab
